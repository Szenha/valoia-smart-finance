VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# Usada exclusivamente para transcricao de audio do registro por voz.
OPENAI_API_KEY=
# Opcional; padrao: gpt-4o-mini-transcribe.
OPENAI_TRANSCRIPTION_MODEL=
# Chave de API da Asaas (Integracoes > Chave de API no painel Asaas).
ASAAS_API_KEY=
# "sandbox" ou "production", conforme o ambiente da chave acima.
ASAAS_ENV=production
# Token de autenticacao do webhook Asaas (gerado localmente, nao pode ser igual a ASAAS_API_KEY).
# Cole este mesmo valor no campo "Token de autenticacao" ao criar o webhook no painel Asaas.
ASAAS_WEBHOOK_TOKEN=
# URL do projeto Supabase (mesmo valor de VITE_SUPABASE_URL). Necessaria no
# servidor porque variaveis VITE_* nao ficam disponiveis no runtime do Worker.
SUPABASE_URL=
# Chave service_role do Supabase (Project Settings > API > service_role).
# Usada pelo webhook da Asaas para liberar a assinatura sem um usuario logado.
# NUNCA expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=
